# Calendario HVAC SIYS — configuración local
# Copia estos valores en .env. No uses service_role, sb_secret ni contraseñas
# de usuarios en la configuración que se embebe en dist/.

# Supabase Connect dialog / Settings > API Keys
# Formato esperado: https://<project-ref>.supabase.co
SIYS_SUPABASE_URL=
# Clave pública para navegador y CLI; normalmente empieza por sb_publishable_.
# La clave anon heredada también es de bajo privilegio, pero se prefiere publishable.
SIYS_SUPABASE_PUBLISHABLE_KEY=

# Cuenta dedicada de prueba para tests autenticados de Pages/Playwright.
# No uses aquí una cuenta operativa ni compartas estos valores en capturas/logs.
SIYS_SMOKE_EMAIL=
SIYS_SMOKE_PASSWORD=

# Supabase CLI: acceso al proyecto y a sus migraciones.
# SUPABASE_PROJECT_REF es el identificador de la URL del Dashboard:
# https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=
# Personal Access Token de Supabase para supabase login/operaciones remotas.
SUPABASE_ACCESS_TOKEN=
# Contraseña de Postgres del proyecto; sólo se usa al enlazar o evitar prompts.
SUPABASE_DB_PASSWORD=

# Opcional: ubicación de la sesión local de `calendary cloud login`.
# Si se deja vacío, Calendary usa la ruta predeterminada del usuario.
CALENDARY_SESSION_FILE=

# Playwright no necesita credenciales aquí. La skill usa su runtime aislado.
# Sólo define estas variables si el runtime está instalado en otra ubicación:
# PLAYWRIGHT_ENV_ROOT=
# PLAYWRIGHT_PYTHON=
# PLAYWRIGHT_NODE_EXE=
# PLAYWRIGHT_CLI_PROJECT_ROOT=
# PLAYWRIGHT_CLI_PATH=
