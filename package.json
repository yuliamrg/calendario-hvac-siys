{
  "name": "calendario-hvac-siys",
  "private": true,
  "type": "module",
  "description": "Orquestación privada de SIYS Sync Web, Calendary CLI y Platform.",
  "workspaces": [
    "apps/web",
    "apps/cli",
    "packages/platform"
  ],
  "bin": {
    "calendary": "./apps/cli/bin/calendary.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "verify": "npm run test && npm run architecture:check && npm run build && npm run version:check && npm run audit",
    "version:check": "node scripts/version-check.mjs",
    "cli": "node apps/cli/bin/calendary.js",
    "cli:smoke": "node --test tests/cli.test.mjs",
    "cli:e2e": "node --test tests/cli-e2e.test.mjs",
    "test:cli": "npm run cli:smoke && npm run cli:e2e && npm run test:cli-release",
    "goal:check": "npm run verify && npm run test:cli",
    "release:web:check": "node scripts/version-check.mjs --product web --require-tag",
    "release:cli:check": "node scripts/version-check.mjs --product cli --require-tag --require-head",
    "build:cli-release": "node scripts/build-cli-release.mjs",
    "test:cli-release": "node --test tests/cli-release.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^2.111.0"
  }
}
